{
  "manifest_version": 3,
  "name": "Pulso",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "version": "0.12.0",
  "description": "Conferência de processos migrados do SAJ para o SEEU: extrai os dados migrados, permite corrigir/excluir/incluir na conferência e exporta relatório do dia.",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "host_permissions": [
    "https://seeu.pje.jus.br/*",
    "https://seeuintegra.pje.jus.br/*",
    "https://seeuimplantacao.pje.jus.br/*",
    "https://seeutreino.pje.jus.br/*",
    "https://bnmp.pdpj.jus.br/*",
    "https://bnmp-homologacao.stg.pdpj.jus.br/*",
    "https://*.amazonaws.com/*"
  ],
  "side_panel": {
    "default_path": "src/panel/panel.html"
  },
  "action": {
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  }
}
